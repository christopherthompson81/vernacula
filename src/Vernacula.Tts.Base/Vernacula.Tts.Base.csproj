<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Vernacula.Tts.Base</RootNamespace>
    <AssemblyName>Vernacula.Tts.Base</AssemblyName>
    <!--
      EP arrives as a global property (defaulted in Directory.Build.props, or -p:EP= on the
      command line) and reaches every referenced project on its own. Mirrors the pattern in
      Vernacula.Base — PrivateAssets="all" keeps the package out of consumers' output; each
      consumer brings its own OnnxRuntime variant.
    -->
    <EP Condition="'$(EP)' == ''">Cuda</EP>
  </PropertyGroup>

  <ItemGroup Condition="'$(EP)' == 'Cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="$(OnnxRuntimeVersion)"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(EP)' == 'Cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)"
                      PrivateAssets="all" />
  </ItemGroup>
  <!-- Pinned, not inherited. With no group here, an EP=DirectML build compiled against whatever
       Vernacula.Phonemizer happens to pin transitively: today that is 1.24.4, which is what
       DirectML wants, but the day the submodule moves to 1.29 these builds would silently acquire
       the managed-on-older-native skew the rest of this change exists to remove. -->
  <ItemGroup Condition="'$(EP)' == 'DirectML'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="$(OnnxRuntimeVersion)"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- NAudio: voice-prompt WAV decode + resample to 24 kHz mono. -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <!-- Markdig: markdown AST for MarkdownTextExtractor. Kept in step with the
       pin in Vernacula.Avalonia (MarkdownFlowBuilder) so a composite app
       resolves one copy. Markdown.Avalonia is not involved — it parses
       markdown with its own engine and pulls no Markdig of its own. -->
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <!-- ONNX protobuf: read the base transformer graph (initializer external-data
       offsets + MatMul-node→weight map) and the IPA diff .onnx, to fold the
       fine-tune onto the base at load (OmniVoiceDiff). Grpc.Tools compiles
       proto/onnx.proto -> C# (messages only, no gRPC); build-time only. -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.68.1" PrivateAssets="all" />
    <Protobuf Include="proto/onnx.proto" GrpcServices="None" ProtoRoot="proto" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared ORT plumbing: OrtSessionBuilder, ExecutionProvider enum, etc.
         ⚠ NO SetConfiguration HERE. Vernacula.Avalonia references Vernacula.Base directly AND
         through this project; an EP override on this reference gave Base a different global-
         property set on the second path, so MSBuild built it twice into the same directory and
         the two writes raced on deps.json ("being used by another process") — the #121 failure
         again. EP is already a global property and flows here unchanged. -->
    <ProjectReference Include="..\Vernacula.Base\Vernacula.Base.csproj">
      <Private>true</Private>
    </ProjectReference>
    <!-- The phonemizer: canonical IPA for the IPA-conditioned OmniVoice path (Vernacula.Tts.CLI) and,
         rendered through KokoroFormat, Kokoro's G2P. Vendored as a git submodule under external/;
         its data/ tree is located at runtime by PhonemizerData.

         ⚠ Its Microsoft.ML.OnnxRuntime reference is a PLAIN (CPU) one, not PrivateAssets="all"
         like the EP-selected package above, so it flows transitively into every consumer of this
         project. A Cuda/DirectML consumer must outrank it with a direct ExcludeAssets="all"
         reference or the CPU native library lands next to the GPU one and whichever copies last
         wins — see Vernacula.Tts.CLI.csproj for the block and the explanation. -->
    <ProjectReference Include="..\..\external\vernacula-phonemizer\csharp\Vernacula.Phonemizer\Vernacula.Phonemizer.csproj" />
  </ItemGroup>

</Project>
