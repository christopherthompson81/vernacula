<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!--
      EP is passed by consuming projects (Vernacula.CLI, Parakeet.WPF).
      PrivateAssets="all" keeps this package out of consumers' output;
      each consumer brings its own OnnxRuntime variant (Gpu, DirectML, Cpu).
    -->
    <EP Condition="'$(EP)' == ''">Cuda</EP>
    <DefineConstants Condition="'$(EP)' == 'DirectML'">$(DefineConstants);DIRECTML</DefineConstants>
    <DefineConstants Condition="'$(EP)' == 'Cpu'">$(DefineConstants);CPU</DefineConstants>
  </PropertyGroup>

  <!-- Compile-time OnnxRuntime reference — PrivateAssets="all" so consuming projects
       provide their own variant at runtime without package duplication.
       The managed assembly version here must match what the consuming app provides at runtime. -->
  <ItemGroup Condition="'$(EP)' == 'Cuda' AND !($([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'X64')">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="$(OnnxRuntimeVersion)"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(EP)' == 'DirectML'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="$(OnnxRuntimeVersion)"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(EP)' == 'Cpu' AND !($([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'X64')">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)"
                      PrivateAssets="all" />
  </ItemGroup>
  <!-- macOS x64 (Intel): 1.24.x dropped osx-x64 native support; pin to 1.19.2 to match runtime -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'X64'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- FfmpegAudioDecoder.DecodeInvocations and Mp3Decoder.DecodeInvocations are test seams:
       they let the audio-format tests assert that PCM WAV stays on the in-process NAudio path
       and MP3 on the in-process NLayer path, instead of only asserting that each decoded
       somehow — which is what a regression to the ffmpeg subprocess would still pass (#176). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Vernacula.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio"            Version="3.1.0" />
    <PackageReference Include="MathNet.Numerics"  Version="5.0.0" />
    <!-- ⚠ NLayer IS THE MP3 DECODER NAudio 3 NO LONGER SHIPS HERE, not an optimisation.
         NAudio 3 hands Mp3FileReader's ACM/MediaFoundation P/Invokes to a Windows target
         framework only, so this net10.0 project cannot decode MP3 with NAudio on ANY host —
         see Mp3Decoder.cs. NLayer is pure managed (net8.0/netstandard2.0, MIT, same authors
         as NAudio), brings no native assets, and so lands harmlessly in every CLI and test
         project that references Base.

         ⚠ 3.x, NOT 1.16.0, AND THE DIFFERENCE IS SILENT DATA LOSS. NLayer 1.16.0 decodes
         only about half of any MPEG-2 / MPEG-2.5 file — every sample rate at or below
         24 kHz — and reports the full duration while doing it. A 16 kHz mono voice memo,
         which is exactly the shape an ASR tool is handed, came back at half length with no
         error anywhere: the transcript was simply missing half the words, at plausible
         timestamps. tests/fixtures carries 8 kHz and 16 kHz fixtures so a downgrade fails
         loudly instead. -->
    <PackageReference Include="NLayer"            Version="3.0.0" />
    <!-- Ogg Vorbis (NVorbis under an NAudio 3 wrapper) and Ogg Opus (Concentus, the managed
         port of libopus). Both pure managed and permissively licensed — MIT and BSD-3 — so,
         like NLayer, they carry no native assets into the projects that reference Base.
         Together with NLayer and NAudio.Core's own WAV/AIFF readers they are what lets
         ReadAudio decode the common audio formats with no FFmpeg installed at all. -->
    <PackageReference Include="NAudio.Vorbis"     Version="3.0.0" />
    <PackageReference Include="Concentus"         Version="2.2.2" />
    <PackageReference Include="Concentus.OggFile" Version="1.0.7" />
    <!-- Note: NemoNfaAligner uses an in-house SimpleSpTokenizer (greedy LPM
         over vocab.txt). Microsoft.ML.Tokenizers 2.0.0's
         SentencePieceTokenizer.Create throws IndexOutOfRangeException on
         the NeMo FastConformer's unigram-SP proto — the loader's
         SentencePieceUnigramModel..ctor assumes BOS/EOS pieces the NeMo
         model doesn't define. Drop in a real SP unigram loader (when
         either ML.Tokenizers fixes the bug or a usable third-party lib
         appears) by swapping SimpleSpTokenizer for it; tokenizer.model
         is preserved in the export bundle for exactly that drop-in. -->
  </ItemGroup>

  <!-- Vernacula.Tests exercises internal helpers (e.g. NemoNfaAligner.GroupTokensIntoWords)
       that are deliberately not part of the public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Vernacula.Tests" />
    <InternalsVisibleTo Include="AsrBackendCoverage" />
  </ItemGroup>

</Project>
