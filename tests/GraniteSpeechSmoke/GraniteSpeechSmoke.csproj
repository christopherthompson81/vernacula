<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Vernacula.GraniteSpeechSmoke</RootNamespace>
    <AssemblyName>GraniteSpeechSmoke</AssemblyName>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- The .Gpu package includes the CPU provider as fallback, so this is
         enough for both 'ep cpu' and 'ep cuda' runtime modes. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.29.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vernacula.Base\Vernacula.Base.csproj">
      <Private>true</Private>
      <SetConfiguration>EP=Cuda</SetConfiguration>
    </ProjectReference>
  </ItemGroup>

</Project>
