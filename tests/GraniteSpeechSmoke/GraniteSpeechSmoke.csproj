<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Vernacula.GraniteSpeechSmoke</RootNamespace>
    <AssemblyName>GraniteSpeechSmoke</AssemblyName>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pull in Vernacula.Base for AudioUtils.ReadAudio + DownmixToMono.
         Suppress its CUDA/DML EP transitive so the smoke runs on CPU. -->
    <ProjectReference Include="..\..\src\Vernacula.Base\Vernacula.Base.csproj">
      <Private>true</Private>
      <SetConfiguration>EP=Cpu</SetConfiguration>
    </ProjectReference>
  </ItemGroup>

</Project>
