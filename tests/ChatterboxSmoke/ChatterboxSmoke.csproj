<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Vernacula.ChatterboxSmoke</RootNamespace>
    <AssemblyName>ChatterboxSmoke</AssemblyName>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!-- Selected by EP, like the apps and the probe scripts: the GPU package has no native for
       any platform but x64 (and EP=Cuda is rejected off x64 in Directory.Build.props), so an arm64
       machine needs the plain runtime rather than a suppressed one. -->
  <ItemGroup Condition="'$(EP)' == 'Cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="$(OnnxRuntimeVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(EP)' != 'Cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vernacula.Base\Vernacula.Base.csproj">
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Vernacula.Tts.Base\Vernacula.Tts.Base.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
